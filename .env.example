# =========================================================================
# Environment configuration template.
#
# Copy this file to `.env` and fill in real values locally.
# NEVER commit an actual `.env` file (it's already in .gitignore).
#
# Not all of these are used yet — they're listed here so the full
# configuration surface is visible from day one. Each group notes
# which session/module actually starts reading it.
# =========================================================================

# ---- General ----
NODE_ENV=development                  # development | production

# ---- Backend (Node/Express) — used from Module 1, Session 1.2 ----
BACKEND_PORT=4000
AI_SERVICE_URL=http://localhost:8000  # base URL of the FastAPI service

# ---- Frontend (React/Vite) — used from Module 1, Session 1.4 ----
# Vite only exposes env vars prefixed with VITE_ to browser code.
VITE_BACKEND_URL=http://localhost:4000

# ---- AI Service (Python/FastAPI) — used from Module 1, Session 1.3 ----
AI_SERVICE_PORT=8000

# ---- PostgreSQL — used from Module 2 onward ----
# DATABASE_URL is what the backend actually connects with. The three
# POSTGRES_* vars below are used by docker-compose.yml to configure
# the Postgres container itself — keep them in sync with the values
# inside DATABASE_URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/legal_research
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=legal_research

# ---- Vector database (ChromaDB) — used from Module 3 ----
# Leave CHROMA_PERSIST_DIR blank to default to ai-service/chroma_data
# automatically (resolved relative to the ai-service folder itself,
# not whatever directory a script happens to be run from).
CHROMA_PERSIST_DIR=
CHROMA_COLLECTION_NAME=pk_judgments

# ---- Embedding model — used from Module 3 ----
# This is the DEFAULT model. Multiple models can be compared
# side-by-side (see ai-service/app/model_registry.py) without
# touching this value — it only controls what a plain, un-parameterized
# call to embed_texts()/semantic_search() uses.
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# ---- Reranker — used from Module 4 ----
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_MODEL_NAME=

# ---- Ingestion pipeline — used from Module 2 ----
# Point these at wherever your judgment PDFs actually live on disk.
# They don't need to be inside this repo. Defaults to
# ingestion/data/raw/<court>/ if left unset.
INGESTION_SC_DIR=
INGESTION_IHC_DIR=
# Whichever provider you choose (Anthropic, OpenAI, local model, etc.)
LLM_PROVIDER=
LLM_MODEL_NAME=
LLM_API_KEY=
